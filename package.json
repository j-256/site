{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "write-cname": "tsx --env-file-if-exists=.env scripts/write-cname.ts",
    "write-og": "tsx --env-file-if-exists=.env scripts/write-og.ts",
    "prebuild": "npm run write-cname && npm run write-og",
    "predev": "npm run write-cname && npm run write-og",
    "fetch-repo-meta": "tsx --env-file-if-exists=.env scripts/fetch-repo-meta.ts",
    "build": "npm run fetch-repo-meta && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:visual": "node tests/visual/run-all.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.1",
    "@vitest/ui": "^4.1.7",
    "playwright": "^1.61.1",
    "tsx": "^4.23.12",
    "vitest": "^4.1.7"
  }
}
