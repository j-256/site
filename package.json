{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "write-cname": "tsx --env-file-if-exists=.env scripts/write-cname.ts",
    "prebuild": "npm run write-cname",
    "predev": "npm run write-cname",
    "fetch-repo-meta": "tsx --env-file-if-exists=.env scripts/fetch-repo-meta.ts",
    "build": "npm run fetch-repo-meta && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^6.3.7",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/ui": "^4.1.7",
    "tsx": "^4.22.3",
    "vitest": "^4.1.7"
  }
}
