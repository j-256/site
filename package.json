{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "write-cname": "tsx --env-file-if-exists=.env scripts/write-cname.ts",
    "write-og": "tsx --env-file-if-exists=.env scripts/write-og.ts",
    "prebuild": "npm run write-cname && npm run write-og",
    "predev": "npm run write-cname && npm run write-og && npm run fetch-projects",
    "fetch-projects": "tsx --env-file-if-exists=.env scripts/fetch-projects.ts",
    "refresh-project-cache": "tsx --env-file-if-exists=.env scripts/fetch-projects.ts --update-cache",
    "build": "npm run fetch-projects && astro build",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "capture:cover": "tsx scripts/capture-cover.ts",
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "test": "npm run test:unit && npm run check:docs-cover",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:visual": "node test/visual/run-all.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.5.0",
    "@vitest/ui": "^5.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0",
    "wrangler": "4.129.1"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
