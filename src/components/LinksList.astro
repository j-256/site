---
import { links } from '../data/links';
import { formatSymlinkRow } from '../lib/format';

// Break long targets at path separators only. Without the explicit <wbr> the
// browser breaks inside hostnames and slugs (github.com/j- / 256), which reads
// as a typo. Escapes first because the result is injected with set:html; the
// only input is the hand-authored links data, never user input
function breakableTarget(target: string): string {
  const escaped = target
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped.replace(/\//g, '/<wbr>');
}

const rows = links.map(l => ({
  href: l.target,
  prefix: formatSymlinkRow({ perms: l.perms, owner: l.owner }),
  name: l.name,
  target: breakableTarget(l.target.replace(/^https:\/\/(www\.)?/, '')),
}));
---
<ul class="links" aria-label="Links" data-row-count={rows.length}>
  {rows.map(row => (
    <li class="link-row">
      <a href={row.href} class="row-link" target="_blank" rel="noopener noreferrer"><span class="prefix">{row.prefix}</span> <span class="name">{row.name}</span> <span class="arrow">-&gt;</span>&#160;<span class="target" set:html={row.target} /></a>
    </li>
  ))}
</ul>

<style>
  .links { list-style: none; padding: 0; }
  .link-row { padding: 0.125em 0; }
  .row-link {
    display: block;
    min-height: 44px;
    text-decoration: none;
    white-space: pre-wrap;
    padding-left: 2ch;
    text-indent: -2ch;
  }
  .prefix { white-space: pre; }
  .name {
    font-weight: 700;
    color: var(--fg-bright);
    white-space: nowrap;
  }
  /* Arrow is atomic and glued to its target by the nbsp in the markup, so a
     wrap never leaves a dangling '-' at the end of a line */
  .arrow { white-space: pre; }
  /* nowrap plus the injected <wbr> means the only break points are slashes */
  .target { white-space: nowrap; }
  .row-link:hover .prefix,
  .row-link:focus-visible .prefix { color: var(--fg-bright); }
  /* Colour alone is a weak focus signal, and the sticky header can overlap a
     row scrolled beneath it. An outline plus scroll-margin keeps the focused
     row both visible and unobscured */
  .row-link:focus-visible {
    outline: 2px solid var(--fg-bright);
    outline-offset: 2px;
    scroll-margin-top: 5em;
  }
</style>
