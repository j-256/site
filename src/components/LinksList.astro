---
import { links } from '../data/links';
import { formatSymlinkRow } from '../lib/format';

const rows = links.map(l => ({
  href: l.target,
  prefix: formatSymlinkRow({ perms: l.perms, owner: l.owner }),
  name: l.name,
  target: l.target.replace(/^https:\/\/(www\.)?/, ''),
}));
---
<ul class="links wide-rows" aria-label="Links">
  {rows.map(row => (
    <li class="link-row">
      <a href={row.href} class="row-link" target="_blank" rel="noopener noreferrer">
        <span class="row-prefix">{row.prefix}  {row.name}  -&gt; {row.target}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .links { list-style: none; padding: 0; }
  .link-row { padding: 0.125em 0; }
  .row-link {
    display: block;
    min-height: 44px;
    text-decoration: none;
    white-space: pre;
    overflow-x: auto;
  }
  .row-link:hover .row-prefix,
  .row-link:focus-visible .row-prefix { color: var(--fg-bright); }
</style>
