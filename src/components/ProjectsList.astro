---
import { projects, type Project, type MetaSource } from '../data/projects';
import cache from '../data/repo-meta.cache.json';
import { formatLsRow } from '../lib/format';

function isMetaSource(meta: Project['meta']): meta is MetaSource {
  return typeof meta === 'object' && meta !== null && 'source' in meta;
}

function resolveMeta(p: Project): string {
  if (!isMetaSource(p.meta)) return p.meta;
  const entry = (cache as Record<string, { value: string; fetchedAt: string }>)[p.repo];
  if (!entry) {
    throw new Error(`No cache entry for ${p.repo}; run npm run fetch-repo-meta`);
  }
  return entry.value;
}

const rows = projects.map(p => ({
  href: `https://github.com/${p.repo}`,
  prefix: formatLsRow({
    perms: p.perms,
    owner: p.owner,
    meta: resolveMeta(p),
  }),
  name: p.name,
  desc: p.desc,
}));
---
<ul class="projects wide-rows" aria-label="Projects">
  {rows.map(row => (
    <li class="project-row">
      <a href={row.href} class="row-link" target="_blank" rel="noopener noreferrer" draggable="false">
        <span class="prefix">{row.prefix}  {row.name}</span>
        <span class="annotation"># {row.desc}</span>
      </a>
    </li>
  ))}
</ul>

<script is:inline>
  // Selecting text inside a full-row <a> still fires click on mouseup, which
  // navigates away. Cancel the click when a non-empty selection exists.
  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('.row-link');
    if (!link) return;
    var sel = window.getSelection();
    if (sel && sel.toString().length > 0) {
      e.preventDefault();
    }
  });
</script>

<style>
  .projects { list-style: none; padding: 0; }
  .project-row { padding: 0.125em 0 0.5em; }
  .row-link {
    display: block;
    text-decoration: none;
    min-height: 44px;
  }
  .prefix {
    display: block;
    white-space: pre;
    overflow-x: auto;
  }
  .annotation {
    display: block;
    color: var(--fg-dim);
    padding-left: 2ch;
    /* Wrap at the prose column even though the row container extends wider. */
    max-width: var(--content-width);
    user-select: text;
  }
  .row-link:hover .prefix,
  .row-link:focus-visible .prefix { color: var(--fg-bright); }
  .row-link:hover .annotation,
  .row-link:focus-visible .annotation { color: var(--fg); }
</style>
