---
// Site identity bar. Sits in normal flow under the boot transcript, becomes
// sticky once the viewport scrolls past it
import { WORDMARK, TAGLINE } from '../data/site';
---
<div class="hostbar-threshold" data-hostbar-threshold aria-hidden="true"></div>
<header class="hostbar" data-hostbar>
  <div class="hostbar-topline">
    <h1 class="wordmark">{WORDMARK}</h1>
    <nav class="page-shortcuts" aria-label="Page shortcuts">
      <a class="page-shortcut top-shortcut" href="#top" data-top-shortcut aria-hidden="true" tabindex="-1">[top]</a>
      <a class="page-shortcut" href="#links">[links]</a>
    </nav>
  </div>
  <p class="hostbar-subline">
    <span class="tagline">{TAGLINE}</span>
    <span class="pong-controls" data-pong-controls>
      <span><kbd>[esc]</kbd> dismiss/show</span>
      <span><kbd>[P]</kbd> pause/resume</span>
    </span>
  </p>
</header>

<script is:inline>
  var hostbar = document.querySelector('[data-hostbar]');
  var hostbarThreshold = document.querySelector('[data-hostbar-threshold]');
  var topShortcut = document.querySelector('[data-top-shortcut]');
  if (hostbar && hostbarThreshold && topShortcut) {
    new IntersectionObserver(function (entries) {
      var stuck = entries[0].boundingClientRect.top < 0;
      hostbar.toggleAttribute('data-stuck', stuck);
      if (stuck) topShortcut.removeAttribute('aria-hidden');
      else topShortcut.setAttribute('aria-hidden', 'true');
      topShortcut.tabIndex = stuck ? 0 : -1;
    }).observe(hostbarThreshold);
  }
</script>

<style>
  .hostbar-threshold {
    display: block;
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }
  .hostbar {
    --top-shortcut-width: 5ch;
    --top-shortcut-typing-duration: 180ms;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
    border-bottom: 1px solid var(--fg-dim);
    padding: 0.25em 0;
    margin-bottom: 1.5em;
    min-height: var(--hostbar-sticky-height);
  }
  .hostbar-topline {
    display: flex;
    min-height: var(--tap-target-size);
    align-items: center;
    justify-content: space-between;
    gap: 1em;
  }
  .wordmark {
    font-weight: 700;
    font-size: 1.25em;
    color: var(--fg-bright);
    margin: 0;
  }
  .page-shortcuts {
    display: flex;
    align-items: center;
    gap: 0.75em;
    font-size: 0.85em;
  }
  .page-shortcut {
    display: inline-flex;
    min-height: var(--tap-target-size);
    align-items: center;
    color: var(--fg-dim);
    text-decoration: none;
    white-space: nowrap;
  }
  .top-shortcut {
    width: var(--top-shortcut-width);
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .hostbar[data-stuck] .top-shortcut {
    clip-path: inset(0);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }
  .page-shortcut:hover,
  .page-shortcut:focus-visible { color: var(--fg-bright); }
  .page-shortcut:focus-visible {
    outline: 2px solid var(--fg-bright);
    outline-offset: 2px;
  }
  .tagline {
    font-size: 0.9em;
  }
  .hostbar-subline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
  }
  .pong-controls {
    display: none;
    align-items: baseline;
    gap: 1.25em;
    color: var(--fg-dim);
    font-size: 0.75em;
    white-space: nowrap;
  }
  .pong-controls kbd {
    color: var(--fg);
    font: inherit;
  }
  :global(html[data-animation-mode='force']) .hostbar[data-stuck] .top-shortcut {
    animation: type-top-shortcut var(--top-shortcut-typing-duration) steps(5, end);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-animation-mode='system']) .hostbar[data-stuck] .top-shortcut {
      animation: type-top-shortcut var(--top-shortcut-typing-duration) steps(5, end);
    }
  }
  @media (min-width: 900px) {
    .pong-controls { display: flex; }
  }
  @keyframes type-top-shortcut {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0); }
  }
</style>
