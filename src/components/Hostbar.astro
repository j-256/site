---
// Site identity bar. Sits in normal flow under the boot transcript, becomes
// sticky once the viewport scrolls past it.
import { WORDMARK, TAGLINE } from '../data/site';
---
<header class="hostbar" aria-label="Site header">
  <h1 class="wordmark">{WORDMARK}</h1>
  <p class="tagline">{TAGLINE}</p>
</header>

<style>
  .hostbar {
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
    border-bottom: 1px solid var(--fg-dim);
    padding: 0.5em 0;
    margin-bottom: 1.5em;
  }
  .wordmark {
    font-weight: 700;
    font-size: 1.25em;
    color: var(--fg-bright);
    margin: 0;
  }
  .tagline {
    font-size: 0.9em;
    margin: 0.25em 0 0;
  }
</style>
