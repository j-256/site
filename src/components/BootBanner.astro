---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const bannerWide = readFileSync(resolve(process.cwd(), 'src/data/banner.txt'), 'utf-8');
const bannerNarrow = readFileSync(resolve(process.cwd(), 'src/data/banner-narrow.txt'), 'utf-8');
---
<aside class="boot" aria-label="Boot transcript" data-boot>
  <pre class="banner banner-wide" aria-hidden="true" data-boot-line>{bannerWide}</pre>
  <pre class="banner banner-narrow" aria-hidden="true" data-boot-line>{bannerNarrow}</pre>
  <p class="prompt-line" data-boot-line><span class="prompt">$</span> <span class="cursor" aria-hidden="true"></span></p>
</aside>

<script is:inline>
  // Synchronously decide whether the banner types in or just shows up. The full
  // boot.ts module loads asynchronously and inherits whichever state we set here.
  // The boot block is always visible -- the only question is whether the typing
  // animation runs. Keep this gate in sync with shouldSkipAnimation() in boot.ts.
  (function () {
    var boot = document.querySelector('[data-boot]');
    if (!boot) return;
    var params = new URLSearchParams(location.search);
    var force = params.has('animate');
    var seen = null;
    try { seen = sessionStorage.getItem('bootSeen'); } catch (e) {}
    var reduced = !force && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!force && (seen !== null || reduced)) {
      // Later loads in the same session, and reduced-motion users, see the boot
      // block as static text. No typing animation runs.
    } else {
      boot.classList.add('typing');
      // Override browser scroll restoration so a reload-with-cached-scroll-position
      // doesn't put the viewport below the boot block while the animation plays.
      try { history.scrollRestoration = 'manual'; } catch (e) {}
      window.scrollTo(0, 0);
    }
  })();
</script>

<script>
  import '../scripts/boot';
</script>

<style>
  .boot {
    margin-bottom: 1.5em;
  }
  .banner, .prompt-line {
    margin: 0.5em 0;
  }
  /* Exactly one banner renders per viewport. The 43-column wide asset needs
     25.8em and first fits at 445px; the 37-column narrow one needs 22.2em and
     first fits at 388px. Below that the narrow asset scales to span the padded
     viewport: min() keeps it at natural size wherever it already fits, so one
     declaration covers both cases. Scaling costs alignment with the character
     grid, so it applies only where a natural fit is impossible */
  .banner-narrow { display: none; }
  @media (max-width: 444px) {
    .banner-wide { display: none; }
    .banner-narrow {
      display: block;
      font-size: min(1em, calc((100vw - 2 * var(--pad-mobile)) / 22.2));
    }
  }
  .boot.typing .banner,
  .boot.typing .prompt-line {
    visibility: hidden;
  }
  .boot.typing .typed {
    visibility: visible;
  }
</style>
