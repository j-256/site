---
import Base from '../layouts/Base.astro';
import BootBanner from '../components/BootBanner.astro';
import Section from '../components/Section.astro';
import ProjectsList from '../components/ProjectsList.astro';
import LinksList from '../components/LinksList.astro';
import PromptCursor from '../components/PromptCursor.astro';
---
<Base>
  <BootBanner />

  <Section command="cat ~/about">
    <p>
      <strong>James Klein.</strong>
    </p>
    <p>
      Principal Support Engineer @
      <a href="https://www.salesforce.com/products/commerce-cloud/">Salesforce B2C Commerce Cloud</a>
      (formerly <a href="https://en.wikipedia.org/wiki/Demandware">Demandware</a>) by trade.
    </p>
    <p>
      Off-clock: shell scripts, browser bookmarklets, the occasional userscript and Cloudflare Worker.
    </p>
  </Section>

  <Section command="ls -l ~/projects/">
    <ProjectsList />
  </Section>

  <Section command="ls -l ~/links/">
    <LinksList />
  </Section>

  <PromptCursor />
</Base>
