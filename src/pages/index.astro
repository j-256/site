---
import Base from '../layouts/Base.astro';
import BootBanner from '../components/BootBanner.astro';
import Hostbar from '../components/Hostbar.astro';
import Section from '../components/Section.astro';
import ProjectsList from '../components/ProjectsList.astro';
import LinksList from '../components/LinksList.astro';
import PromptCursor from '../components/PromptCursor.astro';
---
<Base>
  <BootBanner slot="banner" />
  <Hostbar />

  <Section command="cat ~/about">
    <p>
      Principal Support Engineer @
      <a href="https://www.salesforce.com/commerce/">Salesforce B2C Commerce</a>
      (SFCC, formerly <a href="https://en.wikipedia.org/wiki/Demandware">Demandware</a>) by trade. Reverse-engineering platform internals, debugging production integrations, and writing tools that make the next investigation faster.
    </p>
    <p>
      Off the clock: turning awkward, specific problems into software that holds up past the first fix. Shell utilities live at <a href="https://toolio.sh" target="_blank" rel="noopener noreferrer">toolio.sh</a>. Most projects are on <a href="https://github.com/j-256" target="_blank" rel="noopener noreferrer">github.com/j-256</a>, some not on the internet at all.
    </p>
  </Section>

  <Section command="ls -lo ~/projects/">
    <ProjectsList />
  </Section>

  <Section command="ls -lo ~/links/">
    <LinksList />
  </Section>

  <PromptCursor />
</Base>
