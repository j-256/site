---
import Base from '../layouts/Base.astro';
import BootBanner from '../components/BootBanner.astro';
import Hostbar from '../components/Hostbar.astro';
import Section from '../components/Section.astro';
import ProjectsList from '../components/ProjectsList.astro';
import LinksList from '../components/LinksList.astro';
import PromptCursor from '../components/PromptCursor.astro';
---
<Base>
  <BootBanner slot="banner" />
  <Hostbar />

  <Section command="cat ~/about">
    <p>
      Principal Support Engineer @
      <a href="https://www.salesforce.com/products/commerce-cloud/">Salesforce B2C Commerce Cloud</a>
      (formerly <a href="https://en.wikipedia.org/wiki/Demandware">Demandware</a>) by trade. Reverse-engineering platform internals, debugging production integrations, and writing the tools to make it faster.
    </p>
    <p>
      Off the clock: shell utilities at <a href="https://toolio.sh" target="_blank" rel="noopener noreferrer">toolio.sh</a>, a typed SDK for an otherwise-undocumented API, a macOS extension, browser bookmarklets and userscripts, Cloudflare Workers. Most on <a href="https://github.com/j-256" target="_blank" rel="noopener noreferrer">github.com/j-256</a>, some not on the internet at all.
    </p>
  </Section>

  <Section command="ls -lo ~/projects/">
    <ProjectsList />
  </Section>

  <Section command="ls -lo ~/links/">
    <LinksList />
  </Section>

  <PromptCursor />
</Base>
