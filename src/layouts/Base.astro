---
import '../styles/global.css';
import { siteHost, siteUrl } from '../lib/site-host';
import { links } from '../data/links';

const SITE_HOST = siteHost();
const SITE_URL = siteUrl();

const TITLE = `James Klein - ${SITE_HOST}`;
const DESCRIPTION = 'James Klein: builds what the situation calls for, documents it for the next person. Principal Support Engineer @ Salesforce B2C Commerce.';

const sameAs = links
  .map(l => l.target)
  .filter(t => /^https?:\/\//.test(t));

const buildDate = new Date().toISOString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={SITE_URL} />
  <meta name="build-date" content={buildDate} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:url" content={SITE_URL} />
  <meta property="og:site_name" content={SITE_HOST} />
  <meta property="og:image" content={`${SITE_URL}og.png`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={DESCRIPTION} />
  <meta name="twitter:image" content={`${SITE_URL}og.png`} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'James Klein',
    jobTitle: 'Principal Support Engineer',
    worksFor: { '@type': 'Organization', name: 'Salesforce' },
    url: SITE_URL,
    sameAs,
  })} />
</head>
<body>
  <a href="#content" class="skip-link">Skip to content</a>
  <main id="content">
    <slot />
  </main>
</body>
</html>
